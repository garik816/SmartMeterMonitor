config monitor 'main'
	option name 'SmartMeter'
	option type 'arp'
	option host '192.0.2.10'
	option interface 'br-lan'
	option mac '00:11:22:33:44:55'
	option enabled '1'
	option interval '15'
	option timeout '5'
	option retention_days '365'
	option database '/root/smartmeter-availability.sqlite3'
