#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_monitor() {
	local section="$1" enabled kind host url interface mac interval timeout expected_status retention_days database
	config_get_bool enabled "$section" enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get kind "$section" type arp
	config_get host "$section" host ''
	config_get url "$section" url ''
	config_get interface "$section" interface br-lan
	config_get mac "$section" mac ''
	config_get interval "$section" interval 15
	config_get timeout "$section" timeout 5
	config_get expected_status "$section" expected_status 200
	config_get retention_days "$section" retention_days 30
	if [ "$section" = main ]; then
		config_get database "$section" database /root/smartmeter-availability.sqlite3
	else
		config_get database "$section" database "/root/smartmeter-$section.sqlite3"
	fi

	procd_open_instance "$section"
	procd_set_param command /usr/bin/smartmeter-availability run \
		--type "$kind" --host "$host" --url "$url" \
		--interface "$interface" --mac "$mac" \
		--interval "$interval" --timeout "$timeout" \
		--expected-status "$expected_status" --retention-days "$retention_days" \
		--db "$database"
	procd_set_param file /etc/config/smartmeter-availability
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 20
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load smartmeter-availability
	config_foreach start_monitor monitor
}

service_triggers() {
	procd_add_reload_trigger smartmeter-availability
}
