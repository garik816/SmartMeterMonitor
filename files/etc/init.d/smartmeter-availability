#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled host interface mac interval retention_days database
	config_load smartmeter-availability
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get host main host 192.168.1.113
	config_get interface main interface br-lan
	config_get mac main mac 18:DE:50:E1:86:32
	config_get interval main interval 15
	config_get retention_days main retention_days 90
	config_get database main database /root/smartmeter-availability.sqlite3

	procd_open_instance
	procd_set_param command /usr/bin/smartmeter-availability run \
		--host "$host" --interface "$interface" --mac "$mac" \
		--interval "$interval" --retention-days "$retention_days" \
		--db "$database"
	procd_set_param file /etc/config/smartmeter-availability
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 20
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger smartmeter-availability
}
