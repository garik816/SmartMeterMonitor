#!/usr/bin/python3
"""Validated write entrypoint for the LuCI availability monitor page."""

import json
import subprocess
import sys

from smartmeter_config import save_targets


def main():
    try:
        if len(sys.argv) != 2 or len(sys.argv[1]) > 100000:
            raise ValueError("Ожидается конфигурация проверок")
        targets = save_targets(json.loads(sys.argv[1]))
        result = {"ok": True, "targets": targets}
    except (OSError, ValueError, RuntimeError, KeyError, subprocess.SubprocessError) as exc:
        result = {"error": str(exc)}
    print(json.dumps(result, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
