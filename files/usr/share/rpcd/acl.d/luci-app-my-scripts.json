{
	"luci-app-my-scripts": {
		"description": "Read and configure availability monitors",
		"read": {
			"cgi-io": [ "exec" ],
			"file": {
				"/usr/libexec/smartmeter-availability-dashboard": [ "exec" ],
				"/usr/libexec/smartmeter-availability-dashboard *": [ "exec" ]
			}
		},
		"write": {
			"cgi-io": [ "exec" ],
			"file": {
				"/usr/libexec/smartmeter-availability-config": [ "exec" ],
				"/usr/libexec/smartmeter-availability-config *": [ "exec" ]
			}
		}
	}
}
